# Salin file ini menjadi .env lalu isi nilainya. JANGAN commit file .env.
NODE_ENV=development
PORT=5000

# Boleh lebih dari satu origin, pisahkan dengan koma
FRONTEND_URL=http://localhost:3000

# Supabase: Project Settings > API
SUPABASE_URL=https://your-project-ref.supabase.co
# Hanya untuk backend. JANGAN pernah dipakai di frontend.
SUPABASE_SERVICE_ROLE_KEY=

# Minimal 32 karakter acak. Contoh membuat: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Opsional: masa berlaku token login admin (contoh: 30m, 8h, 7d). Default 8h.
JWT_EXPIRES_IN=8h

# --- Terjemahan konten dinamis --- OPSIONAL
# Provider aktif: groq (default) atau gemini. Dipilih eksplisit, TIDAK ada perpindahan otomatis
# ke provider lain saat kuota habis. "gemini" dipertahankan sementara selama masa migrasi.
TRANSLATION_PROVIDER=groq

# Groq API (provider utama). API key dari https://console.groq.com/keys
# HANYA dipakai di backend, jangan masuk frontend dan jangan di-commit.
GROQ_API_KEY=
# Model Groq yang masih aktif dan tersedia di free tier; cek ulang di
# https://console.groq.com/docs/models dan https://console.groq.com/docs/rate-limits
# (daftar model bisa berubah). Contoh: openai/gpt-oss-120b. Tidak ada fallback otomatis ke model lain.
GROQ_MODEL=

# Gemini API via Google AI Studio (dipertahankan sementara; dipakai hanya jika TRANSLATION_PROVIDER=gemini)
# API key dari https://aistudio.google.com/apikey. HANYA dipakai di backend, jangan masuk frontend.
GEMINI_API_KEY=
# Wajib model keluarga Flash yang berlabel "Free of charge" di
# https://ai.google.dev/gemini-api/docs/pricing (cek ulang, daftar model free tier bisa berubah).
# Contoh: gemini-3.6-flash. Tidak ada fallback otomatis ke model lain.
GEMINI_MODEL=

# --- Akreditasi program studi --- OPSIONAL
# Zona waktu untuk menentukan "hari ini" pada status kedaluwarsa (active/expiring/expired).
# Default Asia/Jakarta. Nilai tidak valid otomatis kembali ke default.
# ACCREDITATION_TIMEZONE=Asia/Jakarta

# --- Link dokumen --- OPSIONAL
# Alamat publik API ini, dipakai untuk membentuk link preview/download dokumen.
# Kosong = link relatif ("/api/..."), cukup jika frontend satu origin dengan API atau memakai proxy.
# WAJIB diisi jika frontend dan API berbeda domain. Contoh: https://api.universitaslia.ac.id
BACKEND_PUBLIC_URL=

# --- Google Drive (dokumen akreditasi prodi + peraturan BAN-PT beserta lampiran) --- OPSIONAL
# Tanpa konfigurasi ini server tetap jalan dan dokumen LAMA (Supabase Storage) tetap terbaca,
# tetapi unggah dokumen baru dijawab 503. Isi SEMUA variabel di salah satu cara kredensial (A atau B).
# Panduan lengkap: docs/GOOGLE_DRIVE_SETUP.md. JANGAN pernah commit nilai asli, dan jangan masuk frontend.
#
# Folder ini WAJIB berada di Shared Drive (bukan My Drive) dan Service Account harus menjadi
# "Content manager". ID adalah bagian akhir URL folder (.../folders/<ID>), bukan URL lengkapnya.
GOOGLE_DRIVE_ROOT_FOLDER_ID=

# Cara A (disarankan untuk hosting): email + private key dari file JSON Service Account.
# Salin "client_email" dan "private_key" apa adanya; baris baru boleh ditulis sebagai \n dalam satu baris.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=

# Cara B (untuk lokal): path ke file JSON Service Account di luar repositori. Jangan dipakai bersama Cara A.
# GOOGLE_SERVICE_ACCOUNT_KEY_FILE=

# Perlakuan file lama saat dokumen diganti/dihapus: trash (default; masuk sampah Shared Drive,
# bisa dipulihkan sekitar 30 hari) atau delete (hapus permanen).
# GOOGLE_DRIVE_DELETE_MODE=trash
