# Salin file ini menjadi .env lalu isi nilainya. JANGAN commit file .env.
NODE_ENV=development
PORT=5000

# Boleh lebih dari satu origin, pisahkan dengan koma
FRONTEND_URL=http://localhost:3000

# Supabase: Project Settings > API
SUPABASE_URL=https://your-project-ref.supabase.co
# Hanya untuk backend. JANGAN pernah dipakai di frontend.
SUPABASE_SERVICE_ROLE_KEY=

# Minimal 32 karakter acak. Contoh membuat: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Opsional: masa berlaku token login admin (contoh: 30m, 8h, 7d). Default 8h.
JWT_EXPIRES_IN=8h

# --- Terjemahan konten dinamis --- OPSIONAL
# Provider aktif: groq (default) atau gemini. Dipilih eksplisit, TIDAK ada perpindahan otomatis
# ke provider lain saat kuota habis. "gemini" dipertahankan sementara selama masa migrasi.
TRANSLATION_PROVIDER=groq

# Groq API (provider utama). API key dari https://console.groq.com/keys
# HANYA dipakai di backend, jangan masuk frontend dan jangan di-commit.
GROQ_API_KEY=
# Model Groq yang masih aktif dan tersedia di free tier; cek ulang di
# https://console.groq.com/docs/models dan https://console.groq.com/docs/rate-limits
# (daftar model bisa berubah). Contoh: openai/gpt-oss-120b. Tidak ada fallback otomatis ke model lain.
GROQ_MODEL=

# Gemini API via Google AI Studio (dipertahankan sementara; dipakai hanya jika TRANSLATION_PROVIDER=gemini)
# API key dari https://aistudio.google.com/apikey. HANYA dipakai di backend, jangan masuk frontend.
GEMINI_API_KEY=
# Wajib model keluarga Flash yang berlabel "Free of charge" di
# https://ai.google.dev/gemini-api/docs/pricing (cek ulang, daftar model free tier bisa berubah).
# Contoh: gemini-3.6-flash. Tidak ada fallback otomatis ke model lain.
GEMINI_MODEL=

# --- Akreditasi program studi --- OPSIONAL
# Zona waktu untuk menentukan "hari ini" pada status kedaluwarsa (active/expiring/expired).
# Default Asia/Jakarta. Nilai tidak valid otomatis kembali ke default.
# ACCREDITATION_TIMEZONE=Asia/Jakarta

# --- Link dokumen --- OPSIONAL
# Alamat publik API ini, dipakai untuk membentuk link preview/download dokumen.
# Kosong = link relatif ("/api/..."), cukup jika frontend satu origin dengan API atau memakai proxy.
# WAJIB diisi jika frontend dan API berbeda domain. Contoh: https://api.universitaslia.ac.id
BACKEND_PUBLIC_URL=

# --- Google Drive via OAuth 2.0 (akun Google pribadi; dokumen akreditasi prodi + peraturan BAN-PT) --- OPSIONAL
# Tanpa SEMUA variabel wajib di bawah, server tetap jalan dan dokumen LAMA (Supabase Storage) tetap
# terbaca, tetapi unggah dokumen baru dijawab 503 STORAGE_NOT_CONFIGURED.
# Jika SATU variabel saja diisi, kelima variabel wajib harus valid atau server menolak start.
# Service Account TIDAK didukung. Perubahan .env baru berlaku setelah server DIMULAI ULANG.
# JANGAN pernah commit nilai asli, dan jangan dipakai di frontend.
#
# Pilihan saja (satu-satunya nilai yang valid): oauth
GOOGLE_AUTH_MODE=oauth

# OAuth Client (Google Cloud Console > APIs & Services > Credentials > OAuth client ID, tipe "Web application").
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Harus PERSIS sama dengan "Authorized redirect URI" di OAuth Client, dan berakhir di
# /api/admin/google-drive/callback. https wajib; http hanya untuk localhost di luar production.
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:5000/api/admin/google-drive/callback

# ID folder di Google Drive akun yang dihubungkan: bagian akhir URL folder (.../folders/<ID>), BUKAN URL lengkapnya.
GOOGLE_DRIVE_ROOT_FOLDER_ID=

# Kunci enkripsi refresh token di database: tepat 32 byte (64 karakter hex ATAU base64).
# Buat: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Jangan diganti setelah akun terhubung (token lama tak terbaca -> harus hubungkan ulang).
# Nama lama GOOGLE_OAUTH_ENCRYPTION_KEY sudah TIDAK dipakai.
GOOGLE_OAUTH_TOKEN_ENCRYPTION_KEY=

# Opsional: tujuan redirect ke frontend setelah callback (harus origin yang ada di FRONTEND_URL).
# Kosong = backend menampilkan halaman hasil sederhana.
# GOOGLE_OAUTH_FRONTEND_REDIRECT=http://localhost:3000/admin
# Opsional: masa berlaku state OAuth dalam detik (60 sampai 1800). Default 600.
# GOOGLE_OAUTH_STATE_TTL_SECONDS=600

# Perlakuan file lama saat dokumen diganti/dihapus: trash (default; masuk sampah Drive,
# bisa dipulihkan sekitar 30 hari) atau delete (hapus permanen).
# GOOGLE_DRIVE_DELETE_MODE=trash
