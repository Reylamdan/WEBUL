# Salin menjadi .env.local lalu sesuaikan. JANGAN commit file .env.local.
# Alamat dasar backend (tanpa "/api" dan tanpa garis miring di akhir).
# Satu-satunya konfigurasi koneksi FE -> BE; dibaca di lib/api.ts.
# Development: http://localhost:5000   |   Production: wajib HTTPS, mis. https://api.universitaslia.ac.id
# Catatan: variabel NEXT_PUBLIC_* terlihat publik di browser. Jangan isi secret apa pun di sini.
NEXT_PUBLIC_API_URL=http://localhost:5000
